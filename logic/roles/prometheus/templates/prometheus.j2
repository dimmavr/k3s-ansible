global:
  scrape_interval: 15s

rule_files:
  - '/etc/prometheus/alert_rules.yml'

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['localhost:9093']

scrape_configs:
  - job_name: 'node'
    static_configs:
      - targets:
{% for i in prometheus_node_targets %}
          - '{{ i }}'
{% endfor %}

  - job_name: 'postgres'
    static_configs:
      - targets:
{% for i in prometheus_postgres_targets %}
          - '{{ i }}'
{% endfor %}
